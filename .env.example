# subtitle-ai deployment configuration.
#
# This project's own env vars only -- do NOT confuse this with the
# broader homelab-wide .env some deployments symlink into this project
# directory (unrelated services' secrets: Cloudflare/Twingate/DB
# passwords/etc.). Copy this file to .env and fill in the two required
# paths; everything else has a working default or is genuinely optional.

# --- Required ---

# Host path to your media library root, bind-mounted read/write into
# the container at /data. Must contain series folders named with a
# {tvdb-<id>} tag (see glossary_profile.find_tvdb_id()).
DATA_PATH=/path/to/your/media

# Host path for this app's own persistent config (job database, work
# scratch dir, transcript cache, glossary YAML). Sub-paths used:
#   ${CONFIG_PATH}/subtitle-ai/models      (read-only model weights)
#   ${CONFIG_PATH}/subtitle-ai/cache        (job db, work dir, transcript cache)
#   ${CONFIG_PATH}/subtitle-ai/glossary    (glossary YAML -- see Phase A of
#                                           the production-readiness plan:
#                                           this directory should itself be
#                                           a git repo for version history)
CONFIG_PATH=/path/to/your/appdata

# --- Optional ---

# Container timezone. Defaults to Asia/Kuala_Lumpur (compose.yml) if unset.
TZ=Asia/Kuala_Lumpur

# TheTVDB API v4 credentials (tvdb_client.py) -- metadata enrichment
# only (series title / cast lookup), never a runtime translation
# dependency. Every tvdb_client.py function degrades to None/empty with
# no key configured, which is this deployment's default, working state
# today. TVDB_API_PIN is only needed for a "user subscription" model key.
# TVDB_API_KEY=
# TVDB_API_PIN=

# Optional webhook fired on job failure (see alerting.py). Works with
# any endpoint that accepts a JSON POST (ntfy.sh, Discord, Slack, a
# Telegram bot relay, etc.). Leave unset to disable (the default).
# FAILURE_WEBHOOK_URL=

# Optional shared-secret header (X-API-Key) required on mutating
# endpoints (delete/cancel/retry/glossary-write) -- see api.py's
# require_api_key(). Unset by default (this deployment's confirmed
# LAN-only status makes this cheap insurance, not a requirement); every
# other endpoint, including job creation, stays open regardless. The web
# UI asks for the key the first time one of those actions gets a 401 and
# remembers it in that browser (frontend/src/api/client.ts).
# SUBTITLE_AI_API_KEY=

# Character names per episode, for automatic name protection
# (cast_metadata.py + cast_enrichment.py). Sources: TMDB (this key), TheTVDB
# (TVDB_API_KEY above) and IMDb's free datasets (no key). While idle, the
# worker checks each series every SUBTITLE_AI_CAST_REFRESH_DAYS (default 30,
# 0 = off). It protects a name only if the series' own subtitles use it as a
# name AND the translation engine demonstrably mistranslates it unprotected,
# and only in the episodes it is credited in. Results are on the Series page.
# TMDB_API_KEY=
# SUBTITLE_AI_CAST_REFRESH_DAYS=30

# Sonarr / Radarr (Settings -> General -> API Key). When set, they decide what
# series or movie a file belongs to -- with its TVDB/TMDB/IMDb/TVmaze ids and
# original language -- ahead of the {tvdb-<id>} folder tag (which can be
# missing, misspelled, or out of date). Movies need Radarr to get their own
# glossary and cast-name protection.
# SONARR_URL=http://10.1.10.200:8989
# SONARR_API_KEY=
# RADARR_URL=http://10.1.10.200:7878
# RADARR_API_KEY=

# Plex / Jellyfin: after a job writes a subtitle, ask each to rescan just that
# folder (Plex) / file (Jellyfin) so it appears immediately. Plex token: any
# item -> Get Info -> View XML -> X-Plex-Token in the URL. Jellyfin: Dashboard
# -> API Keys. Best-effort: a server that is down never fails a job.
# SUBTITLE_AI_MEDIA_REFRESH=off disables it.
# PLEX_URL=http://10.1.1.100:32400
# PLEX_TOKEN=
# JELLYFIN_URL=http://10.1.1.100:8096
# JELLYFIN_API_KEY=

# How long a FAILED job's scratch directory (extracted audio, partial
# subtitles under SUBTITLE_AI_WORK_ROOT/<job_id>) is kept for diagnosis
# before the hourly sweep removes it. Completed and cancelled jobs'
# directories are removed immediately. Default 24; 0 = remove on the
# next sweep. Invalid values fall back to the default. See workdir.py.
# SUBTITLE_AI_FAILED_WORK_RETENTION_HOURS=24

# Route translation through a remote GPU host's translate_server.py
# instead of the local NLLB copy, with automatic local fallback if it's
# unreachable -- see translate.remote_translate_batch()'s docstring.
# Unset (the default) = local translation only. Each host's own value (if
# any) belongs in its own .env, never hard-coded in compose.yml, so a
# fresh checkout on a new host defaults to local-only rather than
# silently trying an old deployment's remote server.
# TRANSLATE_SERVER_URL=http://<remote-host>:8091

# Required by both the main app and remote translate-server when remote
# translation is enabled. The client sends this as X-API-Key; /health
# remains unauthenticated for deployment health checks.
# TRANSLATE_SERVER_API_KEY=

# Remote translate-server only (translate_server.py): seconds of
# inactivity before its single resident NLLB model is unloaded to free a
# shared GPU. Never unloads while a request is active. Default 120.
# TRANSLATE_SERVER_IDLE_UNLOAD_SECONDS=120

# Remote translate-server only: the source language warmed at boot so the
# first real request doesn't pay model-load latency. Any code from
# translate.NLLB_LANG ("tr", "ja", "fr", ...). Blank or unrecognised falls
# back to the default, "tr". Default tr.
# TRANSLATE_SERVER_DEFAULT_LANG=tr

# Feed the series glossary + auto-mined names to Whisper as `hotwords`.
# OFF by default: on real Love Is In The Air data a ~60-name list made
# Whisper emit Title Case for ~70% of segments (which NLLB then turns into
# token-spaced English) and cost 3-4 points of word recall; the price of
# leaving it off is ~3-5 points of character-name recall. Set to `on` to
# restore the old behavior. See asr.py's module docstring for the numbers.
# SUBTITLE_AI_ASR_HOTWORDS=off

# ctranslate2 compute type for ASR (faster-whisper). Default "int8": a
# pre-Volta GPU (e.g. a Tesla P4) lacks efficient float16 tensor throughput
# and ctranslate2 refuses to run float16 on it outright. On a GPU with
# efficient float16 support (Ampere+, e.g. an RTX 3070), "float16" is
# faster. See asr.py's AsrConfig.compute_type comment. Not validated here;
# an invalid value surfaces as ctranslate2's own error at model load.
# SUBTITLE_AI_COMPUTE_TYPE=int8

# Is this GPU shared with anything outside subtitle-ai (Tdarr, Jellyfin/Plex
# hardware transcodes)? Default: no -- a dedicated card, like myphy-ai's RTX
# 3070. Setting it restores the contention-safe behaviour the old shared
# Tesla P4 needed: NLLB batch 8 instead of 32, and emptying the CUDA cache
# after every translation chunk. Measured on a 2,678-sentence episode
# (benchmark-results/nllb-rtx3070-2026-09-28.json): dedicated 32x2 ran the
# translation stage in ~45s vs ~147s for the old shared settings.
# SUBTITLE_AI_GPU_SHARED=1

# NLLB generation sizing; overrides whichever profile above applies. Batch
# 64 measured ~20% faster than 32 at ~5GB peak instead of ~4GB. Beams
# change the actual translations (4 beams altered ~28% of lines vs 2), so
# review real output before changing that one.
# SUBTITLE_AI_NLLB_BATCH_SIZE=32
# SUBTITLE_AI_NLLB_NUM_BEAMS=2

# Seconds NLLB stays loaded after a translation, so the next job in a batch
# skips the ~6-10s model load. Evicted early whenever ASR or the Analyze
# sampler needs the GPU, so it never costs them headroom. Default 600 on a
# dedicated GPU, 0 (free after every job) with SUBTITLE_AI_GPU_SHARED set.
# /api/health reports "nllb_resident".
# SUBTITLE_AI_MODEL_IDLE_SECONDS=600

# NLLB inference engine: "ct2" (default; CTranslate2 on a converted copy of
# the same model) or "hf" (transformers). Measured against the library's
# human subtitles over 9,491 lines: same quality (chrF 57.27 vs 57.32, 95%
# CI of the difference [-0.14, +0.05]) at 2.9x the speed. ct2 needs a
# one-time conversion (scripts/convert_nllb_ct2.py); without it the app
# logs a warning and uses hf.
# SUBTITLE_AI_NLLB_BACKEND=ct2
# SUBTITLE_AI_NLLB_CT2_PATH=/models/ct2/nllb-200-distilled-1.3B-float16

# Whisper model to use for stream sampling / language identification in the
# "Analyze" endpoint.  Default "small" uses ~200 MB VRAM rather than the
# ~3 GB of large-v3, eliminating a near-OOM condition on a shared/low-VRAM
# GPU when an "Analyze" click happens to overlap a real ASR/translation job.
# Prerequisite: run  scripts/download_sample_model.py  once on the host to
# pre-cache the model into ${CONFIG_PATH}/subtitle-ai/models (mounted as
# /models read-only inside the container).  If the model is not pre-cached
# the app falls back to large-v3 automatically with a log warning.
# Accepted values: any faster-whisper model name ("small", "base", "medium",
# "large-v3", …).
# SUBTITLE_AI_SAMPLE_MODEL=small

# Free VRAM (GB) the app waits for (up to 20s) before loading a large model
# (large-v3 ASR, NLLB), failing the job with InsufficientVramError instead of
# attempting a load that would likely CUDA-OOM. Protects against another
# program on the same card (Tdarr/Jellyfin/Plex transcodes) -- the GPU lock
# only serializes THIS project's processes. Must be a number; blank or
# invalid falls back to the default. Also forwarded to the remote
# translate-server (compose.translate-server.yml). Default 3.2.
# SUBTITLE_AI_VRAM_MARGIN_GB=3.2

# Re-translate a single-word cue isolated by a real acoustic pause (e.g. one
# word of a sung line) with its neighbouring cue as grounding context, keeping
# the result only on an exact-match extraction. Never changes segmentation.
# On by default; set to off/0/false/no to disable (video jobs only -- an
# uploaded .srt carries no pause information).
# After transcription, correct a capitalised word that is one letter away
# from exactly one character name credited to the episode (cast metadata +
# glossary), unless the series uses that word as an ordinary word:
# "Aydın" -> "Aydan", "Selim" -> "Selin". Measured on 7 episodes against
# human subtitles: name recall 84.9% -> 87.8%, 95% of corrections confirmed.
# off/0/false/no disables it.
# SUBTITLE_AI_NAME_CORRECTION=on

# SUBTITLE_AI_ORPHAN_CONTEXT_PADDING=on

# Natural-dialogue plan (2026-09-28, subtitle_ai/turns.py). Detects a
# speaker-turn change (pause / question-reply / short-reply heuristics, or
# WeSpeaker ONNX voice embeddings) so it can become a real translation-
# context break. Off by default: measured on real S01E01 dialogue, both
# detectors fire on 10%+ of words -- far more than actual turn density --
# and the available human-subtitle ground truth (12 points for the whole
# episode) can't validate precision. See CLAUDE.md for the numbers.
# SUBTITLE_AI_TURN_DETECTION=heuristic

# Natural-dialogue plan (2026-09-28, gated experiment, asr.py). Feeds
# Whisper a short sample of ordinary sentence-case Turkish dialogue with
# interjections as `initial_prompt`, hoping the decoder leans toward
# keeping genuinely-spoken interjections ("Aa!", "Of ya!") it otherwise
# drops. Off by default until measured against the 7-episode baseline
# (WER/name-recall/Title-Case-surge check) -- see CLAUDE.md.
# SUBTITLE_AI_ASR_STYLE=natural
