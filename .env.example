# subtitle-ai deployment configuration.
#
# This project's own env vars only -- do NOT confuse this with the
# broader homelab-wide .env some deployments symlink into this project
# directory (unrelated services' secrets: Cloudflare/Twingate/DB
# passwords/etc.). Copy this file to .env and fill in the two required
# paths; everything else has a working default or is genuinely optional.

# --- Required ---

# Host path to your media library root, bind-mounted read/write into
# the container at /data. Must contain series folders named with a
# {tvdb-<id>} tag (see glossary_profile.find_tvdb_id()).
DATA_PATH=/path/to/your/media

# Host path for this app's own persistent config (job database, work
# scratch dir, transcript cache, glossary YAML). Sub-paths used:
#   ${CONFIG_PATH}/subtitle-ai/models      (read-only model weights)
#   ${CONFIG_PATH}/subtitle-ai-v2/cache    (job db, work dir, transcript cache)
#   ${CONFIG_PATH}/subtitle-ai/glossary    (glossary YAML -- see Phase A of
#                                           the production-readiness plan:
#                                           this directory should itself be
#                                           a git repo for version history)
CONFIG_PATH=/path/to/your/appdata

# --- Optional ---

# Container timezone. Defaults to Asia/Kuala_Lumpur (compose.yml) if unset.
TZ=Asia/Kuala_Lumpur

# TheTVDB API v4 credentials (tvdb_client.py) -- metadata enrichment
# only (series title / cast lookup), never a runtime translation
# dependency. Every tvdb_client.py function degrades to None/empty with
# no key configured, which is this deployment's default, working state
# today. TVDB_API_PIN is only needed for a "user subscription" model key.
# TVDB_API_KEY=
# TVDB_API_PIN=

# Optional webhook fired on job failure (see alerting.py). Works with
# any endpoint that accepts a JSON POST (ntfy.sh, Discord, Slack, a
# Telegram bot relay, etc.). Leave unset to disable (the default).
# FAILURE_WEBHOOK_URL=

# Optional shared-secret header (X-API-Key) required on mutating
# endpoints (delete/cancel/retry/glossary-write) -- see api.py's
# require_api_key(). Unset by default (this deployment's confirmed
# LAN-only status makes this cheap insurance, not a requirement); every
# other endpoint, including job creation, stays open regardless.
# SUBTITLE_AI_API_KEY=

# How long a FAILED job's scratch directory (extracted audio, partial
# subtitles under SUBTITLE_AI_WORK_ROOT/<job_id>) is kept for diagnosis
# before the hourly sweep removes it. Completed and cancelled jobs'
# directories are removed immediately. Default 24; 0 = remove on the
# next sweep. Invalid values fall back to the default. See workdir.py.
# SUBTITLE_AI_FAILED_WORK_RETENTION_HOURS=24

# Remote translate-server only (translate_server.py): seconds of
# inactivity before its single resident NLLB model is unloaded to free a
# shared GPU. Never unloads while a request is active. Default 120.
# TRANSLATE_SERVER_IDLE_UNLOAD_SECONDS=120

# Feed the series glossary + auto-mined names to Whisper as `hotwords`.
# OFF by default: on real Love Is In The Air data a ~60-name list made
# Whisper emit Title Case for ~70% of segments (which NLLB then turns into
# token-spaced English) and cost 3-4 points of word recall; the price of
# leaving it off is ~3-5 points of character-name recall. Set to `on` to
# restore the old behavior. See asr.py's module docstring for the numbers.
# SUBTITLE_AI_ASR_HOTWORDS=off

# Whisper model to use for stream sampling / language identification in the
# "Analyze" endpoint.  Default "small" uses ~200 MB VRAM rather than the
# ~3 GB of large-v3, eliminating the near-OOM condition on the Tesla P4 when
# an "Analyze" click happens to overlap a real ASR/translation job.
# Prerequisite: run  scripts/download_sample_model.py  once on the host to
# pre-cache the model into ${CONFIG_PATH}/subtitle-ai/models (mounted as
# /models read-only inside the container).  If the model is not pre-cached
# the app falls back to large-v3 automatically with a log warning.
# Accepted values: any faster-whisper model name ("small", "base", "medium",
# "large-v3", …).
# SUBTITLE_AI_SAMPLE_MODEL=small
