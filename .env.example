# Copy to .env and adjust. All values here are optional — sensible defaults are baked
# into docker-compose.yml / app/config.py when unset.

# Whisper model size for the primary (faster_whisper) ASR engine: tiny/base/small/medium/large-v3.
# Default is large-v3 (code default); auto-downgraded at runtime if detected VRAM is too
# small for the requested size, and capped at 'small' on CPU-only hosts regardless.
WHISPER_MODEL_SIZE=large-v3

# Optional cloud fallback engines (leave blank to disable; ASR/translation just skip them).
OPENAI_WHISPER_API_KEY=
TRANSLATION_API_KEY=

# Optional: auto-populate a translation glossary from a TVDB series' cast list (see
# Job.tvdb_id). Leave blank to only use manually-supplied glossary entries — never required.
TVDB_API_KEY=
TVDB_API_PIN=

# Number of in-process background worker threads that claim and run jobs.
WORKER_THREADS=1

# Resource limits for the api container. The default large-v3 Whisper + NLLB-200-
# distilled-1.3B combination needs more headroom than a smaller-model setup — drop to
# medium/small Whisper and/or override SUBTITLE_NLLB_MODEL_NAME to distilled-600M (see
# docs/DEPLOYMENT.md) if your host can't spare this much RAM.
API_CPU_LIMIT=4
API_MEM_LIMIT=12g
